/*
    Template for use with Jinja.
    AWA cathode to EYG 5. 
*/

REAL eex_dip_energy = 41.9; 

//--------------------------
// adjustable parameters
//--------------------------

// element params:
REAL focusing_sol_i = {{focusing_sol_i}};  // [A] focusing solenoid current
REAL matching_sol_i = {{matching_sol_i}};  // [A] matching solenoid current
REAL gun_phase = {{gun_phase}};  // [deg] gun phase offset from on-crest
REAL linac_phase = {{linac_phase}};  // [deg] linac phase offset from on-crest
Real linac1_sol_i = {{linac1_sol_i}};  // [A] linac 1 solenoid current
Real linac2_sol_i = {{linac2_sol_i}};  // [A] linac 2 solenoid current
Real linac3_sol_i = {{linac3_sol_i}};  // [A] linac 3 solenoid current
REAL dq4_k1 = {{dq4_k1}};  // [T/m] DQ4 K1, default = 0 (negative focuses on x)
REAL dq5_k1 = {{dq5_k1}};  // [T/m] DQ5 K1, default = 0
REAL dq6_k1 = {{dq6_k1}};  // [T/m] DQ6 K1, defaul = 0
REAL dq7_k1 = {{dq7_k1}};  // [T/m] DQ7 K1, defaul = 0
REAL rq1_k1 = {{rq1_k1}};  // [T/m] RQ1 K1, default = -3.1
REAL rq2_k1 = {{rq2_k1}};  // [T/m] RQ2 K1, default = -3.1

// initial beam params:
// REAL n_particles = {{n_particles}};  // number of macroparticles
REAL charge = {{charge}};  // [C] bunch charge
REAL laser_radius = {{laser_radius}};  // [m] laser radius at cathode

// sim params: 
REAL csr_on = {{csr_on}};  // 1 if CSR on
REAL gun_field_maps = {{gun_field_maps}};  // 2 for 2D vs 3 for 3D gun field map
REAL linac_field_maps = {{linac_field_maps}};  // 2 for 2D vs 3 for 3D linac field map (3D for coupler kick)
REAL autophase = {{autophase}};  // 0: off, 1: lowest accuracy, 6: highest accuracy.
REAL ps_dump_freq = {{ps_dump_freq}};  // 6d phase space coords dump frequency (.h5 file)
REAL stat_dump_freq = {{stat_dump_freq}};  // beam stats dump frequency (.stat file)
REAL repart_freq = {{repart_freq}};  // repartition frequency to balance computational load of computer nodes. default = 10
REAL grid_points = {{grid_points}};  // grid points per dimension, i.e., total grid points = grid_points^3

//--------------------------
// OPAL setup
//--------------------------

OPTION, 
    PSDUMPFREQ = ps_dump_freq,
    STATDUMPFREQ = stat_dump_freq,  
    AUTOPHASE = autophase,
    REPARTFREQ = repart_freq, 
    VERSION = 20220100;

Title, string = "AWA cathode to first EEX EYG5";

Value, {OPALVERSION};

// global params

STRING path_fieldmaps3d = "../awa_fieldmaps_3D";
STRING path_fieldmaps2d = "../awa_fieldmaps_2D";
STRING path_fringes = "../awa_fringes";


//--------------------------
// INITIAL BEAM DISTRIBUTION
//--------------------------

// Initial momentum

REAL Edes = 1.4e-9;  //initial energy in GeV
REAL gamma = (Edes+EMASS)/EMASS; 
REAL beta = sqrt(1-(1/gamma^2));
REAL P0 = gamma*beta*EMASS;  //inital z momentum

//Printing initial energy and momentum to terminal output.
value , {Edes, P0};

REAL rf_freq = 1.3e9;  // [Hz] RF frequency.

BEAM1: BEAM, 
    PARTICLE = ELECTRON, 
    pc = P0, 
    NPART = grid_points^3 * 8,  // 8 macro-particles per cell
    BFREQ = rf_freq * 1E-6, 
    BCURRENT = charge * rf_freq , 
    CHARGE = -1;

DistFT: DISTRIBUTION, 
    TYPE = FLATTOP,
    SIGMAX = 2*laser_radius,  // [m] RMS radius of transverse beam size.  this is actually 2sigma -- radius for unif. distrib.
    SIGMAY = 2*laser_radius, 
    TRISE = 300e-15/2.35*1.6869,  // [s] Rise time in longitudinal direction
    TFALL = 300e-15/2.35*1.6869,  // [s] Fall time in longitudinal direction. see Tab 14.11       
    //TPULSEFWHM = 6e-12,  // [s] FWHM in longitudinal direction (length of plateau)
    TPULSEFWHM = 8e-12, //
    CUTOFFLONG = 4.0,  // Longitudinal cuttoff in units of sigma.
    NBIN = 5,  // Number of energy bins to use during emission.
    EMISSIONSTEPS = 500,  //Number of steps during emssion. Emission time step is adjusted to fit this number.
    EMISSIONMODEL = ASTRA,
    EKIN = 0.55,  // [eV] Kinetic energy of electrons at emission
    EMITTED = True, 
    WRITETOFILE = True;    

// Note 1: ELASER, W, FE, and CATHTEMP are used for the NONEQUIL emission model.
// These values are not necessary when using other models.

// Note 2: laser distribution using the new AWA laser
// stacking 300-fs FWHM (=300/2.35 rms) Gaussian pulse

// Note 3: (on emission time step) FWHM pulse width divided by emission 
// steps gives the time step for the emissions process. 
// i.e 20.0e-12 / 100 gives a time step of 2e-13 (s) during emission. 
// This is the not the same as the time step used in rest of the file. 


//--------------------------
// RF photoinjector (Gun)
//--------------------------

REAL gun_inj_amp   =  61.26; 

photocathode: SOURCE, 
    ORIGIN = {0.0, 0.0, 0.0};

if (gun_field_maps == 2.0){
    REAL gun_freq = 1300.013338990260;
    REAL gun_len  = 0.292707450;

    GUN: RFCAVITY,
        ORIGIN = {0.0, 0.0, 0.0}, 
        L = gun_len, 
        VOLT = gun_inj_amp,
        TYPE = "STANDING",
        FMAPFN = "${path_fieldmaps2d}/GUN.T7", 
        FREQ = gun_freq,
//        APVETO = TRUE,
        LAG = gun_phase * Pi /180.0; 
}
else {
    REAL gun_freq = 1300.0;
    REAL gun_len  = 2.327100e-01;

    GUN: RFCAVITY,
        ORIGIN = {0.0, 0.0, 0.0}, 
        L = gun_len,
        VOLT = gun_inj_amp, 
        TYPE = "STANDING",
        FMAPFN = "${path_fieldmaps3d}/gun3d.T7", 
        FREQ = gun_freq, 
//        APVETO = TRUE,
        LAG = gun_phase * Pi / 180.0; 
}

// Bucking and Focusing Solenoids DS1-DS2
REAL KSBF = (focusing_sol_i/550.0)*0.12017;

solBF: SOLENOID, 
    ORIGIN = {0.0, 0.0, 0.0}, 
    L = 0.5, 
    KS = KSBF, 
    FMAPFN = "${path_fieldmaps2d}/1T7.T7";

// Matching Solenoid DS3
REAL KSM = (matching_sol_i/440.0)*0.61126;

solM: SOLENOID, 
    ORIGIN = {0.0, 0.0, 0.0}, 
    L = 0.486, 
    KS = KSM, 
    FMAPFN = "${path_fieldmaps2d}/M440.T7";

//--------------------------
// Aperture
//--------------------------

AP_MIRROR: DRIFT,
    L=0.005, 
    ELEMEDGE=2.43, 
    APERTURE="RECTANGLE(0.06,0.08,1)";

//--------------------------
// Linac
//--------------------------

// knobs to gang cavity according to klystron
REAL Klystron_2 = 1.; 
REAL Klystron_3 = 1.; 

// amplitude 
REAL L1_Amp = 22.06*Klystron_2;
REAL L2_Amp = 22.06*Klystron_2;
REAL L3_Amp = 22.06*Klystron_3;
REAL L5_Amp = 22.06*Klystron_3;

if (linac_field_maps == 2.0){
    REAL linac_len  = 1.20713;  
    REAL linac_freq = 1300.0;

    L1: RFCAVITY, 
        L = linac_len, 
        FREQ = linac_freq, 
        TYPE = "STANDING",
        FMAPFN = "${path_fieldmaps2d}/DriveLinac.T7",
        VOLT = L1_Amp, 
        LAG = linac_phase * Pi / 180.0,
        ORIENTATION = {0.0, 0.0, 0.0}, 
        ORIGIN = {0.0, 0.0, 0.5769};

    L2: RFCAVITY, 
        L = linac_len, 
        FREQ = linac_freq, 
        TYPE = "STANDING",
        FMAPFN = "${path_fieldmaps2d}/DriveLinac.T7",
        VOLT = L2_Amp, 
        LAG = linac_phase * Pi / 180.0,
        ORIENTATION = {0.0, 0.0, 0.0}, 
        ORIGIN = {0.0, 0.0, 3.3704};

    L3: RFCAVITY, 
        L = linac_len, 
        FREQ = linac_freq, 
        TYPE = "STANDING",
        FMAPFN = "${path_fieldmaps2d}/DriveLinac.T7",
        VOLT = L3_Amp, 
        LAG = linac_phase * Pi / 180.0,
        ORIENTATION = {0.0, 0.0, 0.0}, 
        ORIGIN = {0.0, 0.0, 4.9384};

    L5: RFCAVITY, 
        L = linac_len, 
        FREQ = linac_freq, 
        TYPE = "STANDING",
        FMAPFN = "${path_fieldmaps2d}/DriveLinac.T7",
        VOLT = L5_Amp, 
        LAG = linac_phase * Pi / 180.0,
        ORIENTATION = {0.0, 0.0, 0.0}, 
        ORIGIN = {0.0, 0.0, 8.4166};

}
else { 
    REAL linac_len  = 1.1;
    REAL linac_freq = 1300.400;

    L1: RFCAVITY, 
        L = linac_len, 
        FREQ = linac_freq, 
        TYPE = "STANDING",
        FMAPFN = "${path_fieldmaps3d}/drivelinaccplr_posY.ascii",  // omega3p map cplr at +y
        VOLT = L1_Amp, 
        LAG = linac_phase * Pi / 180.0,
        ORIENTATION = {0.0, 0.0, -90.0},  // coupler on the Right 
        ORIGIN = {0.0, 0.0, 0.5769};
            
    L2: RFCAVITY, 
        L = linac_len, 
        FREQ = linac_freq, 
        TYPE = "STANDING",
        FMAPFN = "${path_fieldmaps3d}/drivelinaccplr_posY.ascii",  // omega3p map cplr at +y
        VOLT = L2_Amp, 
        LAG = linac_phase * Pi / 180.0,
        ORIENTATION = {0.0, 0.0, 90.0},  // coupler on the Left
        ORIGIN = {0.0, 0.0, 3.3704};

    L3: RFCAVITY, 
        L = linac_len, 
        FREQ = linac_freq, 
        TYPE = "STANDING",	
        FMAPFN = "${path_fieldmaps3d}/drivelinaccplr_posY.ascii",  // omega3p map cplr at +y
        VOLT = L3_Amp, 
        LAG = linac_phase * Pi / 180.0,
        ORIENTATION = {0.0, 0.0, 90.0},  // coupler on the Left
        ORIGIN = {0.0, 0.0, 4.9384};

    L5: RFCAVITY, 
        L = linac_len, 
        FREQ = linac_freq, 
        TYPE = "STANDING",
        FMAPFN = "${path_fieldmaps3d}/drivelinaccplr_posY.ascii",  // omega3p map cplr at +y
        VOLT = L5_Amp, 
        LAG = linac_phase * Pi / 180.0,
        ORIENTATION = {0.0, 0.0, -90.0},  // coupler on the Right
        ORIGIN = {0.0, 0.0, 8.4166};
     
}

REAL linac_sol_len = 1.0;  // axial length of the 2D map 

REAL KSL1 = (linac1_sol_i/304.7875)*0.451972;
REAL KSL2 = (linac2_sol_i/330.0000)*0.500875;
REAL KSL3 = (linac3_sol_i/330.0000)*0.500875;

sol_L1: SOLENOID, 
    L = linac_sol_len, 
    KS = KSL1, 
    FMAPFN = "${path_fieldmaps2d}/DS4.T7",
    ORIGIN = {0.0, 0.0, 2.0769 - linac_sol_len/2.};            

sol_L2: SOLENOID, 
    L = linac_sol_len, 
    KS = KSL2, 
    FMAPFN = "${path_fieldmaps2d}/DS5.T7",
    ORIGIN = {0.0, 0.0, 4.7099 - linac_sol_len/2.};            

sol_L3: SOLENOID, 
    L = linac_sol_len, 
    KS = KSL3, 
    FMAPFN = "${path_fieldmaps2d}/DS5.T7",
    ORIGIN = {0.0, 0.0, 6.7766 - linac_sol_len/2.};
       
//--------------------------
// Quadrupole magnets between YAG4 and ED1
//--------------------------

REAL dq_len = 0.12;  // [m] length of blue quads

// IMP  blue quadrupole magnets

DQ4: QUADRUPOLE,
    L = dq_len, 
    ORIGIN = {0.0, 0.0, 13.8002 - dq_len/2}, 
    K1 = dq4_k1;
DQ5: QUADRUPOLE, 
    L = dq_len, 
    ORIGIN = {0.0, 0.0, 14.0652 - dq_len/2}, 
    K1 = dq5_k1;
DQ6: QUADRUPOLE, 
    L = dq_len, 
    ORIGIN = {0.0, 0.0, 14.3152 - dq_len/2}, 
    K1 = dq6_k1;
DQ7: QUADRUPOLE, 
    L = dq_len, 
    ORIGIN = {0.0, 0.0, 14.5852 - dq_len/2}, 
    K1 = dq7_k1;


//--------------------------
// Dipole magnets
//--------------------------

REAL eex_dip_len = 0.3;  // Length of eex dipole magnets (Physical length)
//REAL eex_dip_energy = 42.211;  // [MeV] dipole design energy

if (csr_on == 1.0){
    CSR_FILTER: FILTER,
        TYPE = "Savitzky-Golay",
        NPOINTS = 20, 
        NLEFT = 4,
        NRIGHT = 4,
        POLYORDER = 4;

    CSR_WK: WAKE, 
        TYPE = "1D-CSR-IGF", 
        NBIN = 300, 
        FILTERS = CSR_FILTER;

    ED1: RBEND, 
        ANGLE = -20.00 * Pi / 180.0, 
        FMAPFN = "${path_fringes}/EEXDIP30cm.opal",
        ORIGIN = {0.0, 0.0, 15.5872 - eex_dip_len/2},
        DESIGNENERGY = eex_dip_energy,
        E1 = 0, 
        L = eex_dip_len,
        GAP = 0.05,
        WAKEF = CSR_WK;

    ED2: RBEND,
        ANGLE = 20.00 * Pi / 180.0, 
        FMAPFN = "${path_fringes}/EEXDIP30cm.opal",
        ORIGIN = {6.183724191328090e-01, 0.0, 1.729616425838092e+01 - eex_dip_len/2},
        DESIGNENERGY = eex_dip_energy, 
        E1 = 20.00 * Pi / 180.0,
        L = eex_dip_len, 
        GAP = 0.05, 
        WAKEF = CSR_WK;
        
    ED3: RBEND, 
        ANGLE = -20.00 * Pi / 180.0, 
        FMAPFN = "${path_fringes}/EEXDIP30cm.opal",
        ORIGIN = {6.183724191328090e-01, 0.0, 1.919667925838093e+01 - eex_dip_len/2},
        DESIGNENERGY = eex_dip_energy, 
        E1 = 0, 
        L = eex_dip_len, 
        GAP = 0.05, 
        WAKEF = CSR_WK;
        
    ED4: RBEND,
        ANGLE = 20.00 * Pi / 180.0, 
        FMAPFN = "${path_fringes}/EEXDIP30cm.opal",
        ORIGIN = {1.236744838265618e+00, 0.0, 2.090564351676185e+01 - eex_dip_len/2},
        DESIGNENERGY= eex_dip_energy, 
        E1 = 20.00 * Pi / 180.0,
        L = eex_dip_len, 
        GAP = 0.05,
        WAKEF = CSR_WK;
        
}
else{

    ED1: RBEND,
        ANGLE = -20.00 * Pi / 180.0, 
        FMAPFN = "${path_fringes}/EEXDIP30cm.opal",
        ORIGIN = {0.0, 0.0, 15.5872 - eex_dip_len/2},
        DESIGNENERGY = eex_dip_energy, 
        E1 = 0, 
        L = eex_dip_len, 
        GAP = 0.05;

    ED2: RBEND,
        ANGLE = 20.00 * Pi / 180.0, 
        FMAPFN = "${path_fringes}/EEXDIP30cm.opal",
        ORIGIN = {6.183724191328090e-01, 0.0, 1.729616425838092e+01 - eex_dip_len/2},
        DESIGNENERGY = eex_dip_energy, 
        E1 = 20.00 * Pi / 180.0,
        L = eex_dip_len,
        GAP = 0.05;
        
    ED3: RBEND,
        ANGLE = -20.00 * Pi / 180.0, 
        FMAPFN = "${path_fringes}/EEXDIP30cm.opal",
        ORIGIN = {6.183724191328090e-01, 0.0, 1.919667925838093e+01 - eex_dip_len/2},
        DESIGNENERGY = eex_dip_energy, 
        E1 = 0, 
        L = eex_dip_len, 
        GAP = 0.05;

    ED4: RBEND, 
        ANGLE = 20.00 * Pi / 180.0, 
        FMAPFN = "${path_fringes}/EEXDIP30cm.opal",
        ORIGIN = {1.236744838265618e+00, 0.0, 2.090564351676185e+01 - eex_dip_len/2},
        DESIGNENERGY= eex_dip_energy, 
        E1 = 20.00 * Pi / 180.0,
        L = eex_dip_len, 
        GAP = 0.05;

}

//--------------------------
// Reversing quads
//--------------------------

REAL rq_len = 0.1;  // [m] length of EEX quads

RQ1: QUADRUPOLE, 
    L = rq_len, 
    ORIGIN = {6.183724191328090e-01, 0.0, 1.758116425838092e+01 - rq_len/2}, 
    K1 = rq1_k1;
RQ2: QUADRUPOLE, 
    L = rq_len, 
    ORIGIN = {6.183724191328090e-01, 0.0, 1.891167925838093e+01 - rq_len/2}, 
    K1 = rq2_k1;

//--------------------------
// Screens
//--------------------------

YAG4: MONITOR, 
    ORIGIN = {0.0, 0.0, 11.372}, 
    OUTFN = "YAG4.h5";  // YAG before 4 quads

YAG5: MONITOR, 
    ORIGIN = {0.0, 0.0, 14.5852 - dq_len/2 + 0.24}, 
    OUTFN = "YAG5.h5";  // YAG before ED1

EYG5: MONITOR, 
    ORIGIN = {1.236744838265618e+00, 0.0, 2.090564351676185e+01 - eex_dip_len/2 + 0.4}, 
    OUTFN = "EYG5.h5";  // YAG after ED4

//--------------------------
// DEFINE BEAMLINES
//--------------------------

Injector: LINE = (photocathode, GUN, solBF, solM); 
Linac: LINE = (L1, sol_L1, L2, sol_L2, L3, sol_L3, L5);

// Gun to YAG4
Gun_to_YAG4: LINE = (Injector, Linac, YAG4); 

// YAG4 to YAG5
YAG4_to_YAG5: LINE = (DQ4, DQ5, DQ6, DQ7, YAG5);

// YAG5 to EYG5
YAG5_to_EYG5: LINE = (ED1, ED2, RQ1, RQ2, ED3, ED4, EYG5);

// Complete beamline up to EYG5
MyLine: LINE = (Gun_to_YAG4, YAG4_to_YAG5, YAG5_to_EYG5);


//--------------------------
// RUN SIM
//--------------------------

FS_SC: FIELDSOLVER, 
    FSTYPE = FFT, 
    MX = grid_points,
    MY = grid_points, 
    MT = grid_points, 
    PARFFTX = true, 
    PARFFTY = true, 
    PARFFTT = true, 
    BCFFTX = open, 
    BCFFTY = open, 
    BCFFTT = open,
    BBOXINCR = 1, 
    GREENSF = INTEGRATED;

REAL dtG = 1.0E-12; // gun 
REAL dtL = 1.0E-11; // after gun

TRACK, 
    LINE = MyLine, 
    BEAM = BEAM1, 
    MAXSTEPS = 1000000, 
    DT = {dtG, dtL}, 
    ZSTOP={1.0, 22.0}; 

RUN, 
    METHOD = "PARALLEL-T", 
    BEAM = BEAM1, 
    FIELDSOLVER = FS_SC, 
    DISTRIBUTION = DistFT;
    
ENDTRACK;